# Finnhub API key (company profile/fundamentals data)
FINNHUB_API_KEY=

# Twelve Data API key (historical stock price / OHLCV data)
TWELVEDATA_API_KEY=

# NewsAPI.org API key (news articles)
NEWSAPI_API_KEY=

# override the default HTTP request timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30


# PostgreSQL connection settings (local install)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartstock
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxxxxxxxx

# Gemini API key (Google AI Studio) — powers the AI Research Assistant
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# Max report chunks embedded per Gemini API call.
RAG_EMBED_BATCH_SIZE=10

# Pause (seconds) between successful embedding batches, to stay under
# free-tier requests-per-minute limits proactively. Set to 0 to disable.
RAG_EMBED_INTER_BATCH_DELAY_SECONDS=1.0

# How many times to retry a single batch after a 429 RESOURCE_EXHAUSTED
# response (with exponential backoff, honoring the server's suggested
# retry delay when provided) before giving up on it.
RAG_EMBED_MAX_RETRIES=5


# Times the automatic scheduler runs its two jobs (src/scheduler/jobs.py):
#   daily  = ingestion + ETL, sentiment scoring, ML predictions (current model)
#   weekly = ML model retraining, evaluation, fresh predictions

SCHEDULER_DAILY_TIME=18:00
SCHEDULER_WEEKLY_DAY=sun
SCHEDULER_WEEKLY_TIME=19:00
SCHEDULER_TIMEZONE=UTC

# If true, the Docker `scheduler` service also runs the daily job once
# immediately on container startup, in addition to its regular schedule
# — useful the first time you start a fresh stack so you're not staring
# at an empty dashboard until SCHEDULER_DAILY_TIME arrives.
SCHEDULER_RUN_ON_STARTUP=false

# Host-side ports docker-compose.yml publishes (docker-compose.yml
# itself defaults to 5432/8000 if these are unset — only set these if
# you need different host ports, e.g. because something else on your
# machine already uses 5432 or 8000).
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=8000
